# ==============================================================================
# WTS Cloth Inventory - Environment Configuration Template
# Copy this file to .env.local and update with your credentials
# ==============================================================================

# Application Session Secret (minimum 32 characters for iron-session encryption)
SESSION_SECRET="your-super-secret-random-key-at-least-32-characters-long"

# Primary Supabase Database Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Secondary Supabase Database (Optional - for high-availability backup & failover sync)
SUPABASE_URL_SECONDARY=""
SUPABASE_ANON_KEY_SECONDARY=""
SUPABASE_SERVICE_ROLE_KEY_SECONDARY=""

# Payment Gateway (Razorpay - Optional for online billing/subscriptions)
Razorpay_Key_Id=""
Razorpay_Key_Secret=""

# Deployment & Environment Settings
NODE_ENV="development"
VERCEL_URL="localhost:3000"
